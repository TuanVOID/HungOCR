APP_DB_URL=postgresql://localhost:5432/your_database_name
APP_DB_USER=your_db_user
APP_DB_PASSWORD=your_db_password
APP_DB_DDL=update

# Địa chỉ máy chủ chạy Ollama (Ví dụ máy cục bộ là http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Tên model bạn đã tải/chạy trên Ollama (Ví dụ:  qwen3.5:4B hoặc qwen3.5:9b-q4_K_M)
CLASSIFIER_MODEL=qwen3.5:4B
OCR_LLM_MODEL=qwen3.5:4B

# Giới hạn số ký tự tối đa gửi vào LLM cho mỗi chunk / prompt OCR
LLM_CHUNK_MAX_CHARS=6000
LLM_INPUT_MAX_CHARS=6000

# Giới hạn đầu ra của Ollama (đơn vị token, không phải ký tự)
LLM_OUTPUT_MAX_TOKENS=6000

# Cấu hình LLM cho phần tóm tắt khi xuất Excel
SUMMARY_LLM_MODEL=qwen3.5:4B
SUMMARY_LLM_TEMPERATURE=0.1
SUMMARY_LLM_TIMEOUT_SECONDS=180
SUMMARY_LLM_CHUNK_MAX_CHARS=6000
SUMMARY_LLM_INPUT_MAX_CHARS=6000
SUMMARY_LLM_OUTPUT_MAX_TOKENS=1200

# Giới hạn preflight trước khi OCR / trích xuất (Mặc định khi chạy CPU)
MAX_UPLOAD_FILE_SIZE_BYTES=10485760
MAX_PDF_PAGES=20
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_EDGE=12000
MAX_DOCX_TEXT_CHARS=60000
OCR_LLM_TEMPERATURE=0.1

# Giới hạn preflight nâng cao khi sử dụng GPU (giúp xử lý nhanh hơn, cho phép tệp tin lớn hơn)
MAX_UPLOAD_FILE_SIZE_BYTES_GPU=104857600
MAX_PDF_PAGES_GPU=200
MAX_IMAGE_PIXELS_GPU=80000000
MAX_IMAGE_EDGE_GPU=30000
MAX_DOCX_TEXT_CHARS_GPU=600000

# Cấu hình cổng chạy ứng dụng (Port)
PORT=8092

# Số luồng chạy song song tối đa (mỗi luồng tương ứng 1 core)
OCR_MAX_WORKERS=10
OCR_USE_TEXT_DETECTION_ONLY=true
OCR_RECOGNITION_BATCH=true

# Cấu hình số luồng tối đa cho các thư viện tính toán (OMP, MKL, OpenBLAS)
# Để trống để tự động nhận diện và sử dụng toàn bộ nhân CPU (tối ưu nhất trên Server)
OMP_NUM_THREADS=
MKL_NUM_THREADS=
OPENBLAS_NUM_THREADS=
VECLIB_MAXIMUM_THREADS=
NUMEXPR_NUM_THREADS=

# Kích hoạt tăng tốc phần cứng Intel CPU (MKLDNN/oneDNN) cho PaddlePaddle (1 = Bật, 0 = Tắt)
# Cảnh báo: Đặt thành 1 có thể gây crash (ConvertPirAttribute2RuntimeAttribute) trên một số server dùng PaddlePaddle v2.6+
FLAGS_use_mkldnn=1
FLAGS_use_onednn=1

# Thiết bị chạy OCR: auto (tự động nhận diện), gpu (ép buộc GPU), cpu (ép buộc CPU)
OCR_DEVICE=auto

# Ép buộc sử dụng GPU thành công hay lỗi dừng startup (true = Strict Mode, false = Tự động fallback CPU)
OCR_GPU_REQUIRED=false

# Index của GPU sẽ sử dụng (Ví dụ: 0)
OCR_GPU_INDEX=0

# Backend sử dụng cho bộ Detector (paddle = PaddlePaddle gốc, onnxruntime = Sử dụng ONNX Runtime)
OCR_DETECTOR_BACKEND=paddle

# Đường dẫn đến file mô hình Detector ONNX (Bắt buộc cấu hình khi sử dụng backend 'onnxruntime')
OCR_DETECTOR_ONNX_MODEL=models/onnx/PP-OCRv5_server_det/model.onnx

# Vô hiệu hóa tính năng tự động fallback về CPU của ONNX Runtime khi có lỗi CUDA EP (true = Strict Mode)
OCR_ORT_DISABLE_CPU_FALLBACK=false
